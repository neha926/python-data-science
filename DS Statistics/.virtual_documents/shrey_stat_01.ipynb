df=sns.load_dataset('titanic')


df





df=df[['age','pclass']].dropna()


df[0:100]


df['pclass'].unique()


c1=df[df['pclass']==1]['age']
c2=df[df['pclass']==2]['age']
c3=df[df['pclass']==3]['age']


c1


