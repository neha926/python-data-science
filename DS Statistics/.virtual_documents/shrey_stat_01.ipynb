import numpy as np
d=np.array([2,3,4,6,7,8,9,12,13,16,17,23,25,37,34,37,301])


d


q1=np.percentile(d,25)


q1


q3=np.percentile(d,75)


q3


IQR=q3-q1


IQR


U=q3+1.5*IQR
U




L=q1-1.5*IQR
L


l=[]
for i in d:
    if i>=L and i<=U:
        l.append(i)
d2=np.array(l)


print(d)
print(d2)


import seaborn as sns



sns.boxplot(x=d)


sns.boxplot(x=d2)





import numpy as np 
from scipy.stats import norm



# sample size must be 30>=
sample=[172,174,168,169,171,173,175,170,169,172]



mew=170
std=3
meann=np.mean(sample)
element=len(sample)



z=(meann-mew)/(std/np.sqrt(element))


z


p_val=2*(1-norm.cdf(abs(z)))


p_val


alpha=0.05


if p_val>alpha:
    print("there is difference")
else:
    print("there is no difference")









import numpy as np 
from scipy import stats



sample=[172,174,168,169,171,173,175,170,169,172]


mean=np.mean(sample)
n=len(sample)
# degree of freedom=n-1
std=np.std(sample,ddof=1)
mew=170


t_test=(mean-mew)/(std/np.sqrt(n))


t_test


p_val=2*(1-stats.t.cdf(abs(t_test),df=n-1))
alpha=0.05 #2.262


p_val


if p_val>alpha:
    print("there is difference")
else:
    print("there is no difference")






import numpy as np 
